{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "auditgym/action.schema.json",
  "title": "step(action) — действие агента",
  "description": "Действие — JSON-объект или JSON-строка с ним (строка не длиннее 1 000 000 символов разбирается json.loads; схема применяется к результату). Draft-04 выбран намеренно: в нём integer — число без дробной части в записи, как в коде (limit 50.0 отвергается). Схема описывает всё, что проверяется без данных эпизода; среда сверх неё проверяет только зависящее от данных: есть ли запись с таким id или doc_id, укладывается ли смещение курсора в таблицу (0..total), разбирается ли выражение калькулятора как арифметика (не больше 200 узлов, результат в пределах 10^±60). Действие вне схемы (кроме submit) даёт ограниченную ошибку и расходует шаг; submit вне схемы завершает эпизод с наградой −1.",
  "oneOf": [
    {
      "title": "list_records",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "table"
      ],
      "properties": {
        "type": {
          "enum": [
            "list_records"
          ]
        },
        "table": {
          "enum": [
            "ledger",
            "invoices",
            "payments",
            "fx"
          ]
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ],
          "description": "null — с начала; иначе next_cursor прошлой страницы той же таблицы: «<table>:<смещение>»"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "description": "по умолчанию 50; больше 50 обрезается до 50"
        }
      },
      "anyOf": [
        {
          "properties": {
            "table": {
              "enum": [
                "ledger"
              ]
            },
            "cursor": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^ledger:\\s*[+-]?\\d+(?:_\\d+)*\\s*$"
            }
          }
        },
        {
          "properties": {
            "table": {
              "enum": [
                "invoices"
              ]
            },
            "cursor": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^invoices:\\s*[+-]?\\d+(?:_\\d+)*\\s*$"
            }
          }
        },
        {
          "properties": {
            "table": {
              "enum": [
                "payments"
              ]
            },
            "cursor": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^payments:\\s*[+-]?\\d+(?:_\\d+)*\\s*$"
            }
          }
        },
        {
          "properties": {
            "table": {
              "enum": [
                "fx"
              ]
            },
            "cursor": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^fx:\\s*[+-]?\\d+(?:_\\d+)*\\s*$"
            }
          }
        }
      ]
    },
    {
      "title": "get_record",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "table",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "get_record"
          ]
        },
        "table": {
          "enum": [
            "ledger",
            "invoices",
            "payments",
            "fx"
          ]
        },
        "id": {
          "type": "string",
          "description": "row_id | invoice_id или doc_id | payment_id или doc_id | fx_id"
        }
      }
    },
    {
      "title": "get_document",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "doc_id"
      ],
      "properties": {
        "type": {
          "enum": [
            "get_document"
          ]
        },
        "doc_id": {
          "type": "string"
        }
      }
    },
    {
      "title": "calculator",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "expression"
      ],
      "properties": {
        "type": {
          "enum": [
            "calculator"
          ]
        },
        "expression": {
          "type": "string",
          "maxLength": 300,
          "pattern": "^(?![\\s\\S]*\\*\\*)(?=[\\s\\S]*[0-9])[0-9\\s.+\\-*/%()]*$",
          "description": "только цифры, десятичная точка, пробелы, + - * / // % и скобки; без **"
        }
      }
    },
    {
      "title": "submit",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "findings"
      ],
      "properties": {
        "type": {
          "enum": [
            "submit"
          ]
        },
        "findings": {
          "$ref": "findings.schema.json"
        }
      }
    }
  ]
}
